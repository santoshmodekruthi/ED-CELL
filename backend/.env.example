# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/edcell?retryWrites=true&w=majority

# Long random string used to sign admin JWTs
JWT_SECRET=change-this-to-a-long-random-string

# Cloudinary (image storage)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# Port the Express server listens on (Render sets this automatically)
PORT=5000

# Frontend build reads this one — duplicated here for reference only
VITE_API_URL=http://localhost:5000/api
